# ==============================================================================
# BLADESYNC AI 2026 - CONFIGURACIÓN DE ENTORNO DE PRODUCCIÓN (.env.example)
# ==============================================================================

# Entorno de Ejecución (development / production)
ENVIRONMENT=production
DEBUG=false

# Host y Puerto del Servidor
HOST=0.0.0.0
PORT=8000

# URL Base Pública (para webhooks, QR y links de WhatsApp)
PUBLIC_BASE_URL=https://turnero-irdz.onrender.com/

# Clave Secreta de la Aplicación para JWT y Firma (MANDATORIA EN PRODUCCIÓN)
# Generar con: openssl rand -hex 32
SECRET_KEY=change_this_to_a_secure_random_32_character_secret_key
APP_SECRET_KEY=change_this_to_a_secure_random_32_character_secret_key

# Contraseña Inicial del Administrador (Cambiar inmediatamente en primer login)
ADMIN_INITIAL_PASSWORD=ChangeMe2026!SecuredAdminPassword

# Base de Datos (PostgreSQL en producción o SQLite persistente)
DATABASE_URL=sqlite:///./barberia.db
# Para PostgreSQL: postgresql://user:password@localhost:5432/turnero_prod

# Zona Horaria Oficial de la Barbería (Catamarca, Argentina)
TIMEZONE=America/Argentina/Catamarca

# Orígenes Permitidos para CORS (separados por coma, sin comodines en producción)
ALLOWED_ORIGINS=https://turnero-irdz.onrender.com,http://localhost:8000

# WhatsApp Cloud API (Meta Graph API v20.0)
# Obtener credenciales en Meta Developers: https://developers.facebook.com/apps/
WHATSAPP_ACCESS_TOKEN=EAAG...ficticio_token_meta_graph_api
WHATSAPP_CLOUD_API_TOKEN=EAAG...ficticio_token_meta_graph_api
WHATSAPP_PHONE_NUMBER_ID=109876543210123
WHATSAPP_VERIFY_TOKEN=bladesync_webhook_verify_token_2026
WHATSAPP_APP_SECRET=your_meta_app_secret_here_for_hmac_sha256

# Rate Limiting & Seguridad
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_APPOINTMENT_MAX=30

# Background Worker & Scheduler
# En proceso web único: true. En clusters multi-worker: false (ejecutar worker separado: python -m app.workers.scheduler)
ENABLE_SCHEDULER=true

