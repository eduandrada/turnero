# ==========================================
# BLADESYNC AI 2026 - CONFIGURACIÓN DE ENTORNO (.env.example)
# ==========================================

# Entorno de Ejecución (development / production)
ENV=development

# Puerto y Host del Servidor
HOST=0.0.0.0
PORT=8000

# Clave Secreta de la Aplicación (MANDATORIA EN PRODUCCIÓN)
# Generar una clave aleatoria segura, e.g. `openssl rand -hex 32`
APP_SECRET_KEY=change_this_to_a_secure_random_32_character_secret_key

# Contraseña Inicial del Administrador (se utiliza solo en la siembra inicial)
ADMIN_INITIAL_PASSWORD=ChangeMe2026!Secured

# Base de Datos (SQLite por defecto o PostgreSQL)
DATABASE_URL=sqlite:///./barberia.db

# Configuración de Zona Horaria
TIMEZONE=America/Argentina/Buenos_Aires

# Orígenes Permitidos para CORS (separados por coma)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# WhatsApp Cloud API (Meta Graph API v20.0)
# Obtener credenciales en: https://developers.facebook.com/apps/
WHATSAPP_CLOUD_API_TOKEN=your_whatsapp_cloud_api_token_here
WHATSAPP_PHONE_NUMBER_ID=109876543210123
WHATSAPP_VERIFY_TOKEN=bladesync_webhook_secret_token_2026
