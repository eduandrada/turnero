# Puerto y Host del Servidor
HOST=0.0.0.0
PORT=8000

# Base de datos SQLite / PostgreSQL
DATABASE_URL=sqlite:///./barberia.db

# WhatsApp Cloud API (Meta Developers)
# Obtén estos datos en: https://developers.facebook.com/apps/ -> WhatsApp -> API Setup
WHATSAPP_CLOUD_API_TOKEN=your_whatsapp_permanent_or_temp_token_here
WHATSAPP_PHONE_NUMBER_ID=109876543210123
WHATSAPP_VERIFY_TOKEN=bladesync_webhook_secret_token_2026

# Opcional: Clave para Asesor de Estilo con IA generativa (Gemini o OpenAI)
# Si no se suministra, el sistema utiliza el motor visagista heurístico avanzado integrado.
GEMINI_API_KEY=
